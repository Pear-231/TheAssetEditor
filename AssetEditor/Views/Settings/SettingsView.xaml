<UserControl x:Class="AssetEditor.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:gameinfo="clr-namespace:Shared.Core.Services;assembly=Shared.Core"
             xmlns:behaviors="clr-namespace:Shared.Ui.Common.Behaviors;assembly=Shared.Ui"
             xmlns:loc="clr-namespace:Shared.Ui.Common;assembly=Shared.Ui"
             xmlns:local="clr-namespace:AssetEditor.Views.Settings" xmlns:viewmodels="clr-namespace:AssetEditor.ViewModels"
             xmlns:colourpickerbutton="clr-namespace:Shared.Ui.BaseDialogs.ColourPickerButton;assembly=Shared.Ui"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             mc:Ignorable="d" >

    <UserControl.Resources>
        <ObjectDataProvider x:Key="GameTypeEnums" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="gameinfo:GameTypeEnum"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <local:SettingsEnumConverter x:Key="SettingsEnumConverter"/>
        <DataTemplate x:Key="SettingsEnumConverterTemplate">
            <TextBlock Text="{Binding Converter={StaticResource SettingsEnumConverter}}"/>
        </DataTemplate>

        <Style x:Key="SettingItemPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="5, 14, 10, 0"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SettingDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ABrush.Foreground.Disabled}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0, 2, 0, 6"/>
        </Style>

        <Style x:Key="SettingGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5, 16, 0, 0"/>
            <Setter Property="Padding" Value="0, 10, 0, 10"/>
        </Style>

        <Style x:Key="TreeItemHeaderText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="TreeExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="arrow" Data="M 0 0 L 6 4 L 0 8 Z" Fill="{DynamicResource ABrush.Foreground.Disabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="arrow" Property="Data" Value="M 0 0 L 8 0 L 4 6 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource ABrush.Foreground.Static}"/>
            <Setter Property="Padding" Value="4, 4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="border" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Visibility="Collapsed"
                                                  Style="{StaticResource TreeExpanderToggleStyle}"/>
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="16, 0, 0, 0" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ABrush.Tone4.Background.Selected}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ABrush.AccentTone2.Border.Static}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ABrush.Tone4.Background.MouseOver}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="207"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="5, 10, 5, 0">
            <TreeView x:Name="SettingsTree" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItemChanged="SettingsTree_SelectedItemChanged"
                      PreviewMouseDown="SettingsTree_PreviewMouseDown">
                <TreeView.Resources>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource SettingsTreeItem}"/>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource SettingsTreeItem}"/>
                </TreeView.ItemContainerStyle>

                <TreeViewItem>
                    <TreeViewItem.Tag>
                        <local:SettingsNavTarget Group="{x:Reference ApplicationGroupPanel}"/>
                    </TreeViewItem.Tag>
                    <TreeViewItem.Header>
                        <TextBlock Text="{loc:Loc SettingsWindow.Application}" Style="{StaticResource TreeItemHeaderText}"/>
                    </TreeViewItem.Header>
                    <TreeViewItem>
                        <TreeViewItem.Tag>
                            <local:SettingsNavTarget Group="{x:Reference ApplicationGroupPanel}" Setting="{x:Reference ActiveGamePanel}"/>
                        </TreeViewItem.Tag>
                        <TreeViewItem.Header>
                            <TextBlock Text="{loc:Loc SettingsWindow.ActiveGame}" Style="{StaticResource TreeItemHeaderText}"/>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                    <TreeViewItem>
                        <TreeViewItem.Tag>
                            <local:SettingsNavTarget Group="{x:Reference ApplicationGroupPanel}" Setting="{x:Reference LoadGameFilesOnStartupPanel}"/>
                        </TreeViewItem.Tag>
                        <TreeViewItem.Header>
                            <TextBlock Text="{loc:Loc SettingsWindow.LoadGameFilesOnStartup}" Style="{StaticResource TreeItemHeaderText}"/>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                </TreeViewItem>

                <TreeViewItem>
                    <TreeViewItem.Tag>
                        <local:SettingsNavTarget Group="{x:Reference UIGroupPanel}"/>
                    </TreeViewItem.Tag>
                    <TreeViewItem.Header>
                        <TextBlock Text="{loc:Loc SettingsWindow.UI}" Style="{StaticResource TreeItemHeaderText}"/>
                    </TreeViewItem.Header>
                    <TreeViewItem>
                        <TreeViewItem.Tag>
                            <local:SettingsNavTarget Group="{x:Reference UIGroupPanel}" Setting="{x:Reference LanguagePanel}"/>
                        </TreeViewItem.Tag>
                        <TreeViewItem.Header>
                            <TextBlock Text="{loc:Loc SettingsWindow.Language}" Style="{StaticResource TreeItemHeaderText}"/>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                    <TreeViewItem>
                        <TreeViewItem.Tag>
                            <local:SettingsNavTarget Group="{x:Reference UIGroupPanel}" Setting="{x:Reference ThemePanel}"/>
                        </TreeViewItem.Tag>
                        <TreeViewItem.Header>
                            <TextBlock Text="{loc:Loc SettingsWindow.Theme}" Style="{StaticResource TreeItemHeaderText}"/>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                    <TreeViewItem>
                        <TreeViewItem.Tag>
                            <local:SettingsNavTarget Group="{x:Reference UIGroupPanel}" Setting="{x:Reference StartMaximisedPanel}"/>
                        </TreeViewItem.Tag>
                        <TreeViewItem.Header>
                            <TextBlock Text="{loc:Loc SettingsWindow.StartMaximised}" Style="{StaticResource TreeItemHeaderText}"/>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                    <TreeViewItem>
                        <TreeViewItem.Tag>
                            <local:SettingsNavTarget Group="{x:Reference UIGroupPanel}" Setting="{x:Reference ShowGameWemFilesPanel}"/>
                        </TreeViewItem.Tag>
                        <TreeViewItem.Header>
                            <TextBlock Text="{loc:Loc SettingsWindow.ShowGameWemFiles}" Style="{StaticResource TreeItemHeaderText}"/>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                </TreeViewItem>

                <TreeViewItem ItemsSource="{Binding GameDirectores}">
                    <TreeViewItem.Tag>
                        <local:SettingsNavTarget Group="{x:Reference GameGroupPanel}"/>
                    </TreeViewItem.Tag>
                    <TreeViewItem.Header>
                        <TextBlock Text="{loc:Loc SettingsWindow.GameFiles}" Style="{StaticResource TreeItemHeaderText}"/>
                    </TreeViewItem.Header>
                    <TreeViewItem.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding GameName}" Style="{StaticResource TreeItemHeaderText}"/>
                        </DataTemplate>
                    </TreeViewItem.ItemTemplate>
                    <TreeViewItem.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource SettingsTreeItem}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding GameName}"/>
                        </Style>
                    </TreeViewItem.ItemContainerStyle>
                </TreeViewItem>

                <TreeViewItem>
                    <TreeViewItem.Tag>
                        <local:SettingsNavTarget Group="{x:Reference RenderingGroupPanel}"/>
                    </TreeViewItem.Tag>
                    <TreeViewItem.Header>
                        <TextBlock Text="{loc:Loc SettingsWindow.Rendering}" Style="{StaticResource TreeItemHeaderText}"/>
                    </TreeViewItem.Header>
                    <TreeViewItem>
                        <TreeViewItem.Tag>
                            <local:SettingsNavTarget Group="{x:Reference RenderingGroupPanel}" Setting="{x:Reference CameraModePanel}"/>
                        </TreeViewItem.Tag>
                        <TreeViewItem.Header>
                            <TextBlock Text="{loc:Loc SettingsWindow.CameraMode}" Style="{StaticResource TreeItemHeaderText}"/>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                    <TreeViewItem>
                        <TreeViewItem.Tag>
                            <local:SettingsNavTarget Group="{x:Reference RenderingGroupPanel}" Setting="{x:Reference RenderBackgroundPanel}"/>
                        </TreeViewItem.Tag>
                        <TreeViewItem.Header>
                            <TextBlock Text="{loc:Loc SettingsWindow.RenderBackground}" Style="{StaticResource TreeItemHeaderText}"/>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                    <TreeViewItem>
                        <TreeViewItem.Tag>
                            <local:SettingsNavTarget Group="{x:Reference RenderingGroupPanel}" Setting="{x:Reference GridSizePanel}"/>
                        </TreeViewItem.Tag>
                        <TreeViewItem.Header>
                            <TextBlock Text="{loc:Loc SettingsWindow.GridSize}" Style="{StaticResource TreeItemHeaderText}"/>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                    <TreeViewItem>
                        <TreeViewItem.Tag>
                            <local:SettingsNavTarget Group="{x:Reference RenderingGroupPanel}" Setting="{x:Reference VertexSelectionColourPanel}"/>
                        </TreeViewItem.Tag>
                        <TreeViewItem.Header>
                            <TextBlock Text="{loc:Loc SettingsWindow.VertexSelectionColour}" Style="{StaticResource TreeItemHeaderText}"/>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                    <TreeViewItem>
                        <TreeViewItem.Tag>
                            <local:SettingsNavTarget Group="{x:Reference RenderingGroupPanel}" Setting="{x:Reference OnlyLoadLod0Panel}"/>
                        </TreeViewItem.Tag>
                        <TreeViewItem.Header>
                            <TextBlock Text="{loc:Loc SettingsWindow.OnlyLoadLod0}" Style="{StaticResource TreeItemHeaderText}"/>
                        </TreeViewItem.Header>
                    </TreeViewItem>
                </TreeViewItem>
            </TreeView>
        </DockPanel>

        <Separator Grid.Column="1" Style="{StaticResource VerticalSeparator}" Margin="0, 10, 0, 0" VerticalAlignment="Stretch"/>

        <ScrollViewer x:Name="ContentScrollViewer" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="ContentScrollViewer_ScrollChanged">
            <StackPanel x:Name="SettingsContentPanel" Margin="15,0,5,10" HorizontalAlignment="Left">

                <!-- Application -->
                <StackPanel x:Name="ApplicationGroupPanel">
                    <TextBlock x:Name="ApplicationHeader" Style="{StaticResource SettingGroupHeader}" Text="{loc:Loc SettingsWindow.Application}"/>

                    <StackPanel x:Name="ActiveGamePanel" Style="{StaticResource SettingItemPanel}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Loc SettingsWindow.ActiveGame}"/>
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.ActiveGame.Description}"/>
                        <Grid Margin="0, 0, 0, 6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FFD28A00" Width="3" Margin="0, 0, 8, 0" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.ActiveGame.Warning}" Margin="0"/>
                        </Grid>

                        <ComboBox HorizontalAlignment="Left" Width="200" SelectedItem="{Binding CurrentGame, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  ItemsSource="{Binding Games}" ItemTemplate="{StaticResource SettingsEnumConverterTemplate}"/>
                    </StackPanel>

                    <StackPanel x:Name="LoadGameFilesOnStartupPanel" Style="{StaticResource SettingItemPanel}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Loc SettingsWindow.LoadGameFilesOnStartup}"/>
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.LoadGameFilesOnStartup.Description}"/>
                        <CheckBox HorizontalAlignment="Left" IsChecked="{Binding LoadCaPacksByDefault, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>

                <!-- UI -->
                <StackPanel x:Name="UIGroupPanel">
                    <TextBlock x:Name="UIHeader" Style="{StaticResource SettingGroupHeader}" Text="{loc:Loc SettingsWindow.UI}"/>

                    <StackPanel x:Name="LanguagePanel" Style="{StaticResource SettingItemPanel}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Loc SettingsWindow.Language}"/>
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.Language.Description}"/>
                        <ComboBox HorizontalAlignment="Left" Width="58" SelectedItem="{Binding SelectedLanguage, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableLangauges}"/>
                    </StackPanel>

                    <StackPanel x:Name="ThemePanel" Style="{StaticResource SettingItemPanel}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Loc SettingsWindow.Theme}"/>
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.Theme.Description}"/>
                        <ComboBox HorizontalAlignment="Left" Width="70" SelectedItem="{Binding CurrentTheme, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  ItemsSource="{Binding AvailableThemes}" ItemTemplate="{StaticResource SettingsEnumConverterTemplate}"/>
                    </StackPanel>

                    <StackPanel x:Name="StartMaximisedPanel" Style="{StaticResource SettingItemPanel}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Loc SettingsWindow.StartMaximised}"/>
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.StartMaximised.Description}"/>
                        <CheckBox HorizontalAlignment="Left" IsChecked="{Binding StartMaximised, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel x:Name="ShowGameWemFilesPanel" Style="{StaticResource SettingItemPanel}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Loc SettingsWindow.ShowGameWemFiles}"/>
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.ShowGameWemFiles.Description}"/>
                        <CheckBox HorizontalAlignment="Left" IsChecked="{Binding ShowCAWemFiles, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Game Files -->
                <StackPanel x:Name="GameGroupPanel">
                    <TextBlock x:Name="GameHeader" Style="{StaticResource SettingGroupHeader}" Text="{loc:Loc SettingsWindow.GameFiles}"/>

                    <StackPanel x:Name="GameDataLocationsPanel">
                        <ItemsControl x:Name="GameFilesItemsControl" ItemsSource="{Binding GameDirectores}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style >
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate >
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource SettingItemPanel}">
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding GameName}"/>
                                        <Grid Margin="0, 6, 0, 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="9*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="45"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                        Style="{StaticResource HintedTextBox}"
                                                        Text="{Binding Path}"
                                                        Tag="{Binding PathHint}"
                                                        IsReadOnly="True"
                                                        Margin="0, 0, 5, 0"
                                                        Padding="2.5, 0, 0, 0"/>
                                            <Button Grid.Column="2" Content="..." Width="30" Command="{Binding BrowseCommand}" Margin="0, 0, 10, 0"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Rendering -->
                <StackPanel x:Name="RenderingGroupPanel">
                    <TextBlock x:Name="RenderingHeader" Style="{StaticResource SettingGroupHeader}" Text="{loc:Loc SettingsWindow.Rendering}"/>

                    <StackPanel x:Name="CameraModePanel" Style="{StaticResource SettingItemPanel}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Loc SettingsWindow.CameraMode}"/>
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.CameraMode.Description}"/>
                        <ComboBox HorizontalAlignment="Left" Width="133" SelectedItem="{Binding SelectedCameraMode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  ItemsSource="{Binding CameraModes}" ItemTemplate="{StaticResource SettingsEnumConverterTemplate}"/>
                    </StackPanel>

                    <StackPanel x:Name="RenderBackgroundPanel" Style="{StaticResource SettingItemPanel}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Loc SettingsWindow.RenderBackground}"/>
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.RenderBackground.Description}"/>
                        <ComboBox HorizontalAlignment="Left" Width="101" SelectedItem="{Binding CurrentRenderEngineBackgroundColour, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  ItemsSource="{Binding RenderEngineBackgroundColours}" ItemTemplate="{StaticResource SettingsEnumConverterTemplate}"/>
                    </StackPanel>

                    <StackPanel x:Name="GridSizePanel" Style="{StaticResource SettingItemPanel}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Loc SettingsWindow.GridSize}"/>
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.GridSize.Description}"/>
                        <TextBox Text="{Binding VisualEditorsGridSize, UpdateSourceTrigger=LostFocus}" MaxLength="4" Width="46" HorizontalAlignment="Left" HorizontalContentAlignment="Right"/>
                    </StackPanel>

                    <StackPanel x:Name="VertexSelectionColourPanel" Style="{StaticResource SettingItemPanel}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Loc SettingsWindow.VertexSelectionColour}"/>
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.VertexSelectionColour.Description}"/>
                        <colourpickerbutton:ColourPickerButtonView DataContext="{Binding VertexSelectionColour}" Width="25" Height="25" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel x:Name="OnlyLoadLod0Panel" Style="{StaticResource SettingItemPanel}">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Loc SettingsWindow.OnlyLoadLod0}"/>
                        <TextBlock Style="{StaticResource SettingDescription}" Text="{loc:Loc SettingsWindow.OnlyLoadLod0.Description}"/>
                        <CheckBox HorizontalAlignment="Left" IsChecked="{Binding OnlyLoadLod0ForReferenceMeshes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
